# syntax=docker/dockerfile:1.6
#
# tode — CPU / headless image
# ───────────────────────────
# Headless RT-DETR inference on CPU (no Tk, no CUDA). Installs the CPU-only
# PyTorch wheels to keep the image smaller than the GPU build. Use for
# headless batch annotation, CI jobs, and server-side dataset export.
#
# Build (from repo root):
#   docker build -f docker/Dockerfile-cpu -t tode:cpu .
#
# Run:
#   docker run --rm -v $(pwd)/output:/app/output tode:cpu \
#       python -c "from core.auto_annotator import AutoAnnotator; print(AutoAnnotator().backend_name)"

FROM python:3.12-slim AS base

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    DEBIAN_FRONTEND=noninteractive \
    OPENCV_FFMPEG_CAPTURE_OPTIONS="threads;1" \
    PYTHONPATH="/app/src"

# OpenCV-headless needs libglib2.0 only — no X11, no GL.
RUN apt-get update && apt-get install --no-install-recommends -y \
        libglib2.0-0 \
        ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# CPU-only torch/torchvision from the PyTorch CPU wheel index, then the rest
# of the runtime (transformers + supervision + headless cv2).
RUN pip install --upgrade pip \
    && pip install --index-url https://download.pytorch.org/whl/cpu \
        "torch>=2.2.0" "torchvision>=0.17.0" \
    && pip install \
        "opencv-python-headless>=4.8.0,<5.0.0" \
        "Pillow>=10.0.0" \
        "numpy>=1.24.0,<3.0.0" \
        "requests>=2.28.0" \
        "transformers>=4.48.0" \
        "supervision>=0.22.0"

COPY . .

VOLUME ["/app/output"]

CMD ["python", "-c", "print('tode:cpu — RT-DETR headless build; import core.* from your own script')"]
